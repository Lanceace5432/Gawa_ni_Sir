@model MVC.Models.StudentModel;

<div class="text-center">
    <h1 class="display-4">@ViewBag.KahitAno</h1>
    <span>
        <h3>ID:</h3>
        <label>@Model.ID</label>
    </span>
    <span>
        <h3>Full Name:</h3>
        <label>@Model.FullName</label>
